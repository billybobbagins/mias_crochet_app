rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in account can read/write its own data subtree.
    // This app uses a small set of fixed logins (see CONTEXT.md) — Mia's
    // and a developer/testing account — each isolated to its own uid here.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
